# Copy to .env and fill in. .env is git-ignored.
# Every value can also be supplied as an environment variable or a CLI flag;
# precedence is: CLI flag > environment variable > .env > built-in default.

# --- Model inference (OpenAI-compatible endpoint) -------------------------
# Used by scripts/generate_level*.py, scripts/eval/*.py, scripts/verify_solvability.py
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Web search -----------------------------------------------------------
# Used by scripts/eval/RAG.py. The endpoint has a working default; you only
# need the key. Get one at https://serper.dev
SERPER_API_KEY=
SERPER_ENDPOINT=https://google.serper.dev/search

# --- Wikidata -------------------------------------------------------------
# Point SPARQL_ENDPOINT at a dated mirror to replay verification programs
# against a snapshot instead of live Wikidata.
SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_API=https://www.wikidata.org/w/api.php

# Wikimedia's User-Agent policy asks for a way to contact the operator.
# Put your project URL or email here before running large extraction jobs.
LSB_CONTACT=https://github.com/hengzzzhou/LiveSearchbench
